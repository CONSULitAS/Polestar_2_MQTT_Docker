# Polestar Data Portal: https://data-portal.polestar.com/de/api-credentials/docs
# Copy the Account ID / x-client-id from the "API Documentation" tab.
POLESTAR_ACCOUNT_ID="12345678-1234-1234-1234-123456789abc"
# Generate an API credential in the "API Credential" tab and copy its App client ID.
POLESTAR_CLIENT_ID="your-client-id"
# Copy the Client secret generated with the App client ID.
POLESTAR_CLIENT_SECRET="your-client-secret"
# Copy "Expires on YYYY-MM-DD (90 days)" from the "API Credential" tab.
POLESTAR_CLIENT_SECRET_EXPIRES_AT="2099-12-31"
# VIN of the vehicle (one container per vehicle with its own VIN).
POLESTAR_VIN="LPSVS000000000000"

# Temporary legacy credentials used by run_local.sh until the Data Portal
# runtime replaces the current Polestar ID/GraphQL entry point.
POLESTAR_EMAIL="you@example.com"
POLESTAR_PASSWORD="your-polestar-password"

MQTT_USER=""
MQTT_PASSWORD=""
